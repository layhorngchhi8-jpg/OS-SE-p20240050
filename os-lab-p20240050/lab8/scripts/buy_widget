#!/bin/bash

username="$1"
purchase_quantity="$2"

script_dir="/home/se-chhi-layhorng/bin"
inventory_file="$script_dir/inventory.txt"
sales_log="$script_dir/sales.log"
lock_file="$script_dir/inventory.lock"

if [ "$#" -ne 2 ]; then
    echo "Usage: buy_widget <username> <quantity>"
    exit 1
fi

if ! [[ "$purchase_quantity" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: quantity must be a positive integer."
    exit 2
fi

log_transaction() {
    local user="$1"
    local qty="$2"
    echo "[P20240050] [SUCCESS] $user bought $qty widgets." >> "$sales_log"
}

(
    flock -x 200

    current=$(cat "$inventory_file")

    if [ "$purchase_quantity" -gt "$current" ]; then
        echo "Transaction Failed: Not enough inventory!"
        exit 3
    fi

    new_inventory=$(( current - purchase_quantity ))
    echo "$new_inventory" > "$inventory_file"

    log_transaction "$username" "$purchase_quantity"

    echo "Success: $username purchased $purchase_quantity widget(s). Remaining: $new_inventory"

) 200> "$lock_file"
