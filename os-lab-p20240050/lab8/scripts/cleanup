#!/bin/bash

script_name="$(basename "${BASH_SOURCE[0]}")"

for file in *; do
    [ -f "$file" ] || continue
    [ "$file" = "$script_name" ] && continue

    extension="${file##*.}"

    if [ "$extension" = "$file" ]; then
        continue
    fi

    mkdir -p "$extension"
    mv "$file" "$extension/"
    echo "Moved $file -> $extension/"
done

echo "Cleanup complete."

