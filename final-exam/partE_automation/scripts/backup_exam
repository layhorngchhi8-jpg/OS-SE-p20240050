#!/bin/bash

SRC_DIR="$HOME/os-se-p20240050/final-exam"
BACKUP_DIR="$HOME/exam-backups"
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
ARCHIVE_PATH="$BACKUP_DIR/final-exam-$TIMESTAMP.tar.gz"

mkdir -p "$BACKUP_DIR"

tar -czf "$ARCHIVE_PATH" -C "$HOME/os-se-p20240050" final-exam

echo "Backup created: $ARCHIVE_PATH"
