#!/bin/bash

OUTPUT="$HOME/collector_test/consolidated_report.txt"
> "$OUTPUT"

directories=(
  "$HOME/collector_test/dir1/notes.txt"
  "$HOME/collector_test/dir2/log.txt"
  "$HOME/collector_test/dir3/private.txt"
  "$HOME/collector_test/dir4/missing.txt"
)

echo "Collector run: $(date)" >> "$OUTPUT"
echo "=================================" >> "$OUTPUT"

for file in "${directories[@]}"; do
  if [ ! -e "$file" ]; then
    echo "[SKIP] Missing: $file" >> "$OUTPUT"
    continue
  fi
  if [ ! -r "$file" ]; then
    echo "[SKIP] Not readable: $file" >> "$OUTPUT"
    continue
  fi
  echo "[OK] Reading: $file" >> "$OUTPUT"
  echo "----- Content -----" >> "$OUTPUT"
  cat "$file" >> "$OUTPUT"
  echo "--------------------" >> "$OUTPUT"
done

echo "Collector finished." >> "$OUTPUT"
cat "$OUTPUT"
