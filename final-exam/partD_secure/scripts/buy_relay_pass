#!/bin/bash

BASE_DIR="$HOME/relay_pass_data"
STOCK_FILE="$BASE_DIR/stock.txt"
LOG_FILE="$BASE_DIR/sales_log.txt"
LOCK_FILE="$BASE_DIR/stock.lock"
STUDENT_ID="p20240050"

mkdir -p "$BASE_DIR"

buyer="$1"
qty="$2"

if [ -z "$buyer" ] || [ -z "$qty" ]; then
  echo "Usage: buy_relay_pass <buyer_name> <quantity>"
  exit 1
fi

if ! [[ "$qty" =~ ^[0-9]+$ ]] || [ "$qty" -le 0 ]; then
  echo "Error: quantity must be a positive integer."
  exit 1
fi

if [ ! -f "$STOCK_FILE" ]; then
  echo 150 > "$STOCK_FILE"
fi

touch "$LOCK_FILE"

# Critical section, protected by exclusive advisory lock
(
  flock -x 200

  current_stock=$(cat "$STOCK_FILE")

  if [ "$qty" -gt "$current_stock" ]; then
    echo "Sorry $buyer, not enough stock (requested $qty, available $current_stock)."
    exit 1
  fi

  new_stock=$((current_stock - qty))
  echo "$new_stock" > "$STOCK_FILE"

  echo "$(date '+%Y-%m-%d %H:%M:%S') | buyer=$buyer | qty=$qty | new_stock=$new_stock | student_id=$STUDENT_ID" >> "$LOG_FILE"

  echo "Success: $buyer bought $qty Relay Pass(es). Remaining stock: $new_stock"
) 200>"$LOCK_FILE"
